# ExecuTorch's stock quantised K/V cache kernels (kv_affine.cpp) are linked
# like esp32_asym.cpp: mapped on their own, after the generic flash
# catch-alls, so they move none of the story firmware's functions or tables
# (its timing depends on their placement).
[mapping:kv_affine]
archive: libespressif_backend.a
entries:
    kv_affine (default);
        text->flash_text SURROUND(kv_affine_text),
        rodata->flash_rodata SURROUND(kv_affine_rodata)
