# espressif::qnorm (qnorm.cpp) is linked like quant_lut.cpp: mapped on its own,
# after the generic flash catch-alls, so it moves none of the story firmware's
# functions or tables. Opt-in (Esp32Partitioner(fused_norms=
# True)); the story never runs it.
[mapping:qnorm]
archive: libespressif_backend.a
entries:
    qnorm (default);
        text->flash_text SURROUND(qnorm_text),
        rodata->flash_rodata SURROUND(qnorm_rodata)
