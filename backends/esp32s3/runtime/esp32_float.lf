# The float-weight loops (esp32_float.cpp: the fp32 convolution, the fp16/bf16
# rungs) are linked like esp32_asym.cpp: mapped on their own, after the generic
# flash catch-alls, so they move no hot function or table of the story's
# measured decode. The story's integer weights never reach them.
[mapping:esp32_float]
archive: libespressif_backend.a
entries:
    esp32_float (default);
        text->flash_text SURROUND(esp32_float_text),
        rodata->flash_rodata SURROUND(esp32_float_rodata)
