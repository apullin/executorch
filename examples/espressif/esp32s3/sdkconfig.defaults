# Bring-up config: no PSRAM (the MLP is tiny, and QEMU's 32 MB PSRAM model would
# exhaust the MMU's virtual address range and break partition mmap), UART console
# so QEMU's -serial mon:stdio actually shows output.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 16 MB, matching the N16R8 the model targets (QEMU honours it): the 4.5 MB app
# partition and the parity rows' weight partitions (partitions.csv) need it.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ExecuTorch's Method::load and the portable kernels recurse a little; app_main's
# default 3.5KB stack is not enough headroom to debug comfortably.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
